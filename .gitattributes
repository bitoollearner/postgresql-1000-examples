# Everything in the image must be LF. See the note in tools/companion_files.py:
# docker build copies the working tree, and a CRLF shebang makes the
# container exit immediately with a misleading "no such file or directory".
* text=auto eol=lf

*.sh         text eol=lf
*.py         text eol=lf
*.sql        text eol=lf
*.conf       text eol=lf
*.yml        text eol=lf
*.ipynb      text eol=lf
Dockerfile   text eol=lf
psqlrc       text eol=lf

# PowerShell is the exception: it runs on Windows and CRLF is native there.
*.ps1        text eol=crlf

# Never normalise binaries.
*.png        binary
*.pdf        binary
